{
  "name": "nocturne",
  "version": "0.7.2",
  "private": true,
  "description": "Nocturne : flux plein écran des vidéos de X pour Firefox",
  "scripts": {
    "start": "web-ext run --source-dir . --start-url https://x.com/home",
    "build": "web-ext build --overwrite-dest --artifacts-dir dist",
    "test": "node --test tests/core.test.js"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  },
  "webExt": {
    "ignoreFiles": [
      ".github",
      ".gitignore",
      "README.md",
      "dist",
      "node_modules",
      "package-lock.json",
      "package.json",
      "tests",
      "updates.json",
      "LICENCE"
    ]
  }
}
